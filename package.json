{
  "private": true,
  "version": "1.1.0",
  "scripts": {
    "build": "vite build && mv build/play.js build/build.js 2>/dev/null || true",
    "deploy": "ghpages git@github.com:supermedium/supersaber.git -p .ghpages && rm -rf .ghpages",
    "lint": "semistandard -v | snazzy",
    "lint:fix": "semistandard --fix",
    "predeploy": "npm run build && shx mkdir -p .ghpages && cp -r build/* .ghpages && cp -r vendor .ghpages/vendor",
    "start": "vite",
    "prebuild": "node build-nunjucks.js",
    "test": "vitest run",
    "relay": "node server.js"
  },
  "dependencies": {
    "@mediapipe/camera_utils": "^0.3.1675466862",
    "@mediapipe/hands": "^0.4.1675469240",
    "aframe-aabb-collider-component": "^3.1.0",
    "aframe-atlas-uvs-component": "^2.1.0",
    "aframe-audioanalyser-component": "^5.2.1",
    "aframe-event-decorators": "^1.0.2",
    "aframe-event-set-component": "^4.0.1",
    "aframe-geometry-merger-component": "^2.0.0-beta1",
    "aframe-haptics-component": "^1.4.2",
    "aframe-layout-component": "^5.3.0",
    "aframe-orbit-controls": "^1.2.0",
    "aframe-proxy-event-component": "^2.1.0",
    "aframe-ring-shader": "^1.1.0",
    "aframe-slice9-component": "^1.0.0",
    "aframe-state-component": "^6.4.2",
    "aframe-thumb-controls-component": "^1.1.0",
    "algoliasearch": "^3.29.0",
    "ansi-html": "0.0.7",
    "autoprefixer": "^7.2.3",
    "babel": "6.23.0",
    "babel-minify-webpack-plugin": "0.2.0",
    "body-parser": "1.18.2",
    "classnames": "^2.2.5",
    "core-js": "^3.49.0",
    "debug": "^4.1.0",
    "firebase": "^5.11.1",
    "html-entities": "^1.2.1",
    "html-minifier": "^3.5.11",
    "ip": "1.1.5",
    "json-loader": "^0.5.7",
    "jszip": "^3.10.1",
    "nunjucks": "3.0.1",
    "postcss-loader": "^2.1.6",
    "promise-polyfill": "^8.3.0",
    "tmi.js": "^1.8.3",
    "uglify-js": "git://github.com/mishoo/UglifyJS2#harmony",
    "uglifyjs-webpack-plugin": "0.4.6",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "cross-env": "4.0.0",
    "ghpages": "0.0.10",
    "jsdom": "^29.1.1",
    "semistandard": "10.0.0",
    "shx": "^0.2.2",
    "snazzy": "7.0.0",
    "superagent": "^3.8.2",
    "vite": "^8.1.3",
    "vite-plugin-commonjs": "^0.10.4",
    "vite-plugin-nunjucks": "^0.2.0",
    "vitest": "^4.1.9"
  },
  "semistandard": {
    "globals": [
      "AFRAME",
      "THREE"
    ],
    "ignore": [
      "build/**"
    ]
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
